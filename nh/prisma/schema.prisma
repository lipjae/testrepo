// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 도매시장 정보
model WholesaleMarket {
  marketCode String @id // 공판장코드 13자리 (기본키)
  marketName String // 공판장명

  @@map("wholesale_markets")
}

// 품종 정보
model Variety {
  varietyCode String @id // 품종코드 12자리 (기본키)
  varietyName String // 품종명

  @@map("varieties")
}

// 산지 정보
model Origin {
  originCode String @id @default(cuid()) // 산지코드 (기본키)
  originName String // 산지명

  @@map("origins")
}

// 품종 상세 정보 (거래 데이터)
model VarietiesInfo {
  id          String @id @default(cuid())
  marketCode  String // 공판장코드 13자리
  varietyCode String // 품종코드 12자리
  originCode  String? // 산지코드 (선택적)
  grade       String? // 등급
  weight      Float? // 중량 (소숫점 포함 가능)
  quantity    Int? // 수량
  price       Int? // 경락가
  saleDate    DateTime // 판매일자 (날짜만, 시간 없음)

  @@map("varieties_infos")
}
